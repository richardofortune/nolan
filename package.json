{
  "name": "@richfort/nolan",
  "version": "0.2.1",
  "description": "Screenplay-driven demo films for web apps — direct your real app, get a GIF or MP4 that regenerates on every release.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardofortune/nolan.git"
  },
  "homepage": "https://github.com/richardofortune/nolan#readme",
  "bugs": "https://github.com/richardofortune/nolan/issues",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nolan": "bin/nolan.mjs"
  },
  "main": "src/render.mjs",
  "exports": {
    ".": "./src/render.mjs",
    "./director": "./src/director.mjs",
    "./lint": "./src/lint.mjs"
  },
  "files": [
    "bin/nolan.mjs",
    "src",
    "styles",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node bin/onboard.mjs",
    "onboard": "node bin/onboard.mjs",
    "example": "node bin/nolan.mjs examples/splitter.screenplay.json --cut=hero",
    "example:post": "node bin/nolan.mjs examples/splitter.screenplay.json --cut=hero --overlay=post",
    "restyle:example": "node bin/nolan.mjs restyle examples/out/splitter-hero.segments.json",
    "verify:example": "node bin/nolan.mjs verify examples/splitter.screenplay.json",
    "lint:demos": "for f in examples/*.screenplay.json; do echo \"— $f\"; node bin/nolan.mjs lint \"$f\"; done",
    "example:wikipedia": "node bin/nolan.mjs examples/wikipedia.screenplay.json --cut=full --overlay=post",
    "verify:wikipedia": "node bin/nolan.mjs verify examples/wikipedia.screenplay.json",
    "example:wayback": "node bin/nolan.mjs examples/wayback.screenplay.json --cut=full --overlay=post --out=examples/out",
    "verify:wayback": "node bin/nolan.mjs verify examples/wayback.screenplay.json",
    "example:gcal": "node bin/nolan.mjs examples/gcal.screenplay.json --cut=full --style=examples/gcal.style.json --overlay=post --out=examples/out",
    "verify:gcal": "node bin/nolan.mjs verify examples/gcal.screenplay.json --style=examples/gcal.style.json",
    "example:karaoke": "node bin/nolan.mjs examples/karaoke.screenplay.json --cut=full --style=examples/karaoke.style.json --out=examples/out",
    "example:showcase": "node bin/nolan.mjs examples/showcase.screenplay.json --cut=full --style=examples/showcase.style.json --overlay=post --out=examples/out",
    "example:metademo": "node bin/nolan.mjs examples/metademo.screenplay.json --cut=full --style=examples/metademo.style.json --overlay=post --out=examples/out",
    "example:airbnb": "node bin/nolan.mjs examples/airbnb.screenplay.json --cut=full --style=examples/showcase.style.json --overlay=post --out=examples/out",
    "example:supergold": "node bin/nolan.mjs examples/supergold.screenplay.json --cut=full --style=examples/metademo.style.json --overlay=post --out=examples/out",
    "verify:supergold": "node bin/nolan.mjs verify examples/supergold.screenplay.json --style=examples/metademo.style.json --on-drift=warn",
    "example:support": "node bin/nolan.mjs examples/support-answer.screenplay.json --cut=full --style=examples/showcase.style.json --out=examples/out",
    "example:shipped": "node bin/nolan.mjs examples/shipped-change.screenplay.json --cut=full --style=examples/showcase.style.json --out=examples/out",
    "example:drift": "node bin/nolan.mjs verify examples/drift/stale.screenplay.json",
    "desk": "open editor/style-desk.html || xdg-open editor/style-desk.html || start editor/style-desk.html",
    "desk:embed": "node editor/embed-templates.mjs",
    "desk:check": "node editor/check-fidelity.mjs"
  },
  "keywords": [
    "demo",
    "gif",
    "screencast",
    "playwright",
    "readme",
    "documentation",
    "walkthrough",
    "screenplay"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "dependencies": {}
}
